MEDIA_FETCHER_PORT=8097
# Compatible SQLite account database containing users and sessions tables.
VIBETYPST_DB=/absolute/path/to/control.db
MEDIA_FETCHER_TTL_HOURS=24
MEDIA_FETCHER_QUOTA_GB=50
MEDIA_FETCHER_MAX_FILE_GB=10
MEDIA_FETCHER_MAX_DURATION_HOURS=6
# Local Voice Studio API used by the post-download speech-to-text action.
VOICE_API_URL=http://127.0.0.1:8092
# Optional for tests or non-macOS development. Production uses macOS Keychain.
# MEDIA_FETCHER_FERNET_KEY=
